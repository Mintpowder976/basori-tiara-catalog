{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/basori-tiara/catalog.schema.json",
  "title": "马剃天爱星制品图鉴",
  "type": "object",
  "required": ["schema_version", "catalog", "character", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog": {
      "type": "object",
      "required": ["title", "scope", "updated_at", "status"]
    },
    "character": {
      "type": "object",
      "required": ["id", "name_ja", "name_zh", "aliases"]
    },
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name_ja", "name_zh", "category", "campaign", "campaign_year",
        "manufacturer", "variant", "sale_format", "spec", "release_date",
        "list_price_yen", "official_status", "verification", "images", "sales",
        "sources", "tags", "notes"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name_ja": {"type": "string", "minLength": 1},
        "name_zh": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "campaign": {"type": "string", "minLength": 1},
        "campaign_year": {"type": ["integer", "null"], "minimum": 2020, "maximum": 2100},
        "manufacturer": {"type": "string", "minLength": 1},
        "variant": {"type": "string", "minLength": 1},
        "sale_format": {
          "type": "object",
          "required": ["type", "total_variants"],
          "properties": {
            "type": {"enum": ["single", "random", "set"]},
            "total_variants": {"type": ["integer", "null"], "minimum": 1}
          }
        },
        "spec": {
          "type": "object",
          "required": ["size", "material"],
          "properties": {
            "size": {"type": ["string", "null"]},
            "material": {"type": ["string", "null"]}
          }
        },
        "release_date": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "list_price_yen": {"type": ["integer", "null"], "minimum": 0},
        "official_status": {"enum": ["official", "fanmade", "unknown"]},
        "verification": {"enum": ["confirmed_text", "confirmed_image", "seller_claim", "unverified"]},
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "role", "source_url"]
          }
        },
        "sales": {"type": "array"},
        "sources": {"type": "array", "minItems": 1},
        "tags": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}
